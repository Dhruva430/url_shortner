ENV=production
PORT=8080
API_URL=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
NEXT_PUBLIC_BACKEND_BASE_URL=https://your-domain.com
BACKEND_BASE_URL=http://api:8080

POSTGRES_USER=url
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=postgres
DB_SOURCE=postgresql://url:replace_with_strong_password@postgres:5432/postgres?sslmode=disable

JWT_SECRET=replace_with_strong_jwt_secret
GOOGLE_CLIENT_ID=replace_google_client_id
GOOGLE_CLIENT_SECRET=replace_google_client_secret
RAZORPAY_KEY_ID=replace_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_webhook_secret
